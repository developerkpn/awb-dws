PORT=4000
HOST=127.0.0.1
SITE_ID=dev-site
PREREG_API_URL=http://localhost:3000
SYNC_ENABLED=false
SYNC_POLL_INTERVAL_MS=60000
SYNC_REQUEST_TIMEOUT_MS=10000
INTERNAL_SERVICE_KEY=development-internal-service-secret-key-12345
# To enable local synchronization, set SITE_ID to the destination plant code.
# Production requires a unique key matching the HO map and an HTTPS PREREG_API_URL.

# Plant database: SQL Server. Local dev server: npm run db:up
DATABASE_URL="sqlserver://localhost:1433;database=awb_site;user=sa;password=AwbDev_Passw0rd;encrypt=true;trustServerCertificate=true"

# Weighbridge controllers as a JSON list, 2 per weighbridge. [] = no device connections (development).
CONTROLLERS=[]
# CONTROLLERS=[{"id":"WB1-A","weighbridgeId":"WB1","host":"192.168.10.21","port":5000},{"id":"WB1-B","weighbridgeId":"WB1","host":"192.168.10.22","port":5000}]
