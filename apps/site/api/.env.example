PORT=4000
HOST=127.0.0.1
SITE_ID=dev-site
PREREG_API_URL=http://localhost:3000
SYNC_ENABLED=false
SYNC_POLL_INTERVAL_MS=60000
SYNC_REQUEST_TIMEOUT_MS=10000
INTERNAL_SERVICE_KEY=development-internal-service-secret-key-12345
# To enable local synchronization, set SITE_ID to the destination plant code.
# Production requires a unique key matching the HO map and an HTTPS PREREG_API_URL.

# Plant database: SQL Server. Local dev server: npm run db:up
DATABASE_URL="sqlserver://localhost:1433;database=awb_site;user=sa;password=AwbDev_Passw0rd;encrypt=true;trustServerCertificate=true"

# Weighbridge controllers as a JSON list, 2 per weighbridge. [] = no device connections (development).
CONTROLLERS=[]
# CONTROLLERS=[{"id":"WB1-A","weighbridgeId":"WB1","host":"192.168.10.21","port":5000},{"id":"WB1-B","weighbridgeId":"WB1","host":"192.168.10.22","port":5000}]

# Plant console (site/web) login. APP_ORIGIN is the console URL; the session cookie is Secure when it is https.
APP_ORIGIN=http://localhost:5174
BCRYPT_ROUNDS=12
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=14
SESSION_IDLE_MINUTES=120

# Plant masters are pulled from SAP (ZGW_REGISTRA_SRV). Development reads erpdev, production erpprd over HTTPS.
SAP_ODATA_BASE_URL=http://erpdev-gm.gamasap.com:8000
SAP_SERVICE_USERNAME=
SAP_SERVICE_PASSWORD=
SAP_REQUEST_TIMEOUT_MS=60000
# WB location code in SAP (ZwbLoc), e.g. EU23 for EUP Kijing. Empty = keep every row SAP returns.
SITE_WB_LOCATION=
MASTER_PULL_ENABLED=false
MASTER_PULL_INTERVAL_MINUTES=15

# One-shot WB.NET backfill (npm run masters:backfill -w @awb/site-api). Read-only login; set only when running it.
# WBNET_DATABASE_URL="sqlserver://<host>:1433;database=WBSYSTEM;user=<login>;password=<password>;encrypt=true;trustServerCertificate=true"
# WBNET_COMPANY=EU
# WBNET_LOCATION=K1

