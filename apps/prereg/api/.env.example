PORT=3000

# Customer Pre-Registration database: PostgreSQL. Local dev server: npm run db:up (port 5450)
DATABASE_URL="postgresql://awb:awb_dev_password@127.0.0.1:5450/awb_prereg"

# Session Security
SESSION_SECRET="awb-dev-session-secret-key-32-chars-min"

# SMTP Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@kpn-corp.com
SMTP_SECURE=false

# Document Upload Storage (local disk directory, easily portable to S3)
UPLOAD_DIR=uploads
