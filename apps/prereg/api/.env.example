PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
DATABASE_POOL_MAX=10
SESSION_HOURS=8
SESSION_REMEMBER_DAYS=14
SESSION_IDLE_MINUTES=60
ALLOW_LEGACY_PASSWORDS=false
TRUST_PROXY_HOPS=0
UPLOAD_DIR=.data/uploads
INTERNAL_SERVICE_KEYS={}
# Production requires a JSON map of plant code to its unique service key (32+ characters).
# The shared INTERNAL_SERVICE_KEY fallback is for development/test only.

# Customer Pre-Registration database: PostgreSQL. Local dev server: npm run db:up (port 5450)
DATABASE_URL="postgresql://awb:awb_dev_password@127.0.0.1:5450/awb_prereg"

# OTP and email are deferred. Production provisioning/reset fails closed until delivery exists.

# Downstream JUL SAP integration (non-production requires erpdev/SAPBRIDGE_D; production requires HTTPS erpprd/SAPBRIDGE_P).
JUL_WORKER_ENABLED=false
SAP_ODATA_BASE_URL=http://erpdev-gm.gamasap.com:8000
# SAP_SERVICE_USERNAME=
# SAP_SERVICE_PASSWORD=
# SAP_ORACLE_CONNECT_STRING=
# SAP_ORACLE_USERNAME=
# SAP_ORACLE_PASSWORD=
SAP_REQUEST_TIMEOUT_MS=8000
