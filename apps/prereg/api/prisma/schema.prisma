// Customer pre-registration database (PostgreSQL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Existing physical table names are preserved; new names follow docs/design/penamaan-tabel.md.

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @map("name")
  username     String   @unique @map("username")
  email        String?  @map("email")
  phone        String?  @map("phone")
  city         String?  @map("city")
  country      String?  @map("country")
  passwordHash String   @map("password_hash")
  accountType  String   @default("PARTNER") @map("account_type") // PARTNER | INTERNAL
  roleId       String   @map("role_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role              Role                    @relation(fields: [roleId], references: [id])
  plants            UserPlant[]
  otps              UserOtp[]
  sessions          AuthSession[]
  submittedRequests DriverRequest[]         @relation("SubmittedRequests")
  decidedRequests   DriverRequest[]         @relation("DecidedRequests")
  decisions         DriverRequestDecision[] @relation("DecisionUser")
  documents         Document[]              @relation("UserDocuments")
  julDocuments      JulDocument[]
  julRegistrations  JulRegistration[]       @relation("JulCustomer")
  createdJul        JulRegistration[]       @relation("JulCreator")
  julHistory        JulHistory[]
  julHolds          JulHold[]
  belDocuments      BelDocument[]
  belRegistrations  BelRegistration[]       @relation("BelVendor")
  createdBel        BelRegistration[]       @relation("BelCreator")
  decidedBel        BelRegistration[]       @relation("BelDecider")
  belHistory        BelHistory[]

  @@index([accountType, createdAt, id])
  @@index([createdAt, id])
  @@index([updatedAt])
  @@index([roleId, isActive])
  @@map("mst_user")
}

// Development roles: ADMIN, LOGISTIC, COMMERCIAL, CUSTOMER and VENDOR.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @map("code")
  name        String   @map("name")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("mst_role")
}

// Codes and modules follow permissionCatalogue in @awb/contracts.
model Permission {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @map("code")
  name      String   @map("name")
  module    String   @map("module")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("mst_permission")
}

model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("mst_role_permission")
}

model Plant {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique @map("code") // e.g. "PRISCOLIN_KARAWANG", "DUMAI", "MEDAN"
  name         String   @map("name")
  city         String?  @map("city")
  sapPlantCode String?  @unique @map("sap_plant_code")
  companyGroup String?  @map("company_group")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users        UserPlant[]
  julDocuments JulDocument[]
  julRules     JulPlantRule[]
  belDocuments BelDocument[]

  @@map("mst_plant")
}

model UserPlant {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  plantId   String   @map("plant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@unique([userId, plantId])
  @@index([plantId, userId])
  @@map("mst_user_plant")
}

model UserOtp {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String   @map("email")
  otpCode   String   @map("otp_code")
  purpose   String   @default("FORGOT_PASSWORD") @map("purpose")
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, otpCode])
  @@index([userId])
  @@map("sys_otp")
}

model AuthSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  tokenHash  String   @unique @map("token_hash") // Digest only; the raw session token is never stored.
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
  @@map("auth_session")
}

model AuthRateLimit {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  attempts  Int      @default(1)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("auth_rate_limit")
}

model AccountAudit {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  action    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subjectId, createdAt])
  @@map("account_audit")
}

model Transporter {
  id            String    @id @default(uuid(7)) @db.Uuid
  code          String    @unique
  name          String
  address       String?
  phone         String?
  contactPerson String?   @map("contact_person")
  city          String?   @map("city")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  vehicles      Vehicle[]

  @@map("mst_transporter")
}

model Driver {
  id              String          @id @default(uuid(7)) @db.Uuid
  licenseNumber   String          @unique @map("license_number")
  name            String
  address         String?
  birthPlace      String?         @map("birth_place")
  birthDate       DateTime?       @map("birth_date")
  phone           String?
  city            String?         @map("city")
  licensePhotoUrl String?         @map("license_photo_url")
  driverPhotoUrl  String?         @map("driver_photo_url")
  isActive        Boolean         @default(true) @map("is_active")
  inSap           Boolean         @default(false) @map("in_sap")
  sapLocation     String?         @map("sap_location")
  sapSyncedAt     DateTime?       @map("sap_synced_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  requests        DriverRequest[]

  @@index([inSap, isActive])
  @@map("mst_driver")
}

model Vehicle {
  id            String    @id @default(uuid(7)) @db.Uuid
  plateNumber   String    @unique @map("plate_number")
  transporterId String?   @map("transporter_id") @db.Uuid
  stnkPhotoUrl  String?   @map("stnk_photo_url")
  isActive      Boolean   @default(true) @map("is_active")
  inSap         Boolean   @default(false) @map("in_sap")
  sapLocation   String?   @map("sap_location")
  sapSyncedAt   DateTime? @map("sap_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  transporter Transporter?    @relation(fields: [transporterId], references: [id])
  requests    DriverRequest[]

  @@index([transporterId])
  @@index([inSap, isActive])
  @@map("mst_vehicle")
}

model DriverRequest {
  id          String @id @default(uuid(7)) @db.Uuid
  kind        String @default("DRIVER")
  status      String @default("SUBMITTED")
  submittedBy String @map("submitted_by") @db.Uuid

  driverId              String?   @map("driver_id") @db.Uuid
  driverLicenseNumber   String?   @map("driver_license_number")
  driverName            String?   @map("driver_name")
  driverAddress         String?   @map("driver_address")
  driverAddress2        String?   @map("driver_address2")
  driverAddress3        String?   @map("driver_address3")
  driverBirthPlace      String?   @map("driver_birth_place")
  driverBirthDate       DateTime? @map("driver_birth_date")
  driverPhone           String?   @map("driver_phone")
  driverCity            String?   @map("driver_city")
  driverLicensePhotoUrl String?   @map("driver_license_photo_url")
  driverPhotoUrl        String?   @map("driver_photo_url")

  vehicleId           String? @map("vehicle_id") @db.Uuid
  vehiclePlateNumber  String? @map("vehicle_plate_number")
  vehicleStnkPhotoUrl String? @map("vehicle_stnk_photo_url")
  siteId              String? @map("site_id")

  decidedBy       String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at")
  decision        String?
  rejectionReason String?   @map("rejection_reason")
  sentToPlantAt   DateTime? @map("sent_to_plant_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  submitter User                    @relation("SubmittedRequests", fields: [submittedBy], references: [id])
  decider   User?                   @relation("DecidedRequests", fields: [decidedBy], references: [id])
  driver    Driver?                 @relation(fields: [driverId], references: [id])
  vehicle   Vehicle?                @relation(fields: [vehicleId], references: [id])
  decisions DriverRequestDecision[]

  @@index([status, createdAt, id])
  @@index([submittedBy, createdAt, id])
  @@index([siteId, status, createdAt])
  @@index([kind, status, createdAt])
  @@index([createdAt, id])
  @@index([driverId])
  @@index([vehicleId])
  @@index([decidedBy])
  @@map("awb_driver_request")
}

model DriverRequestDecision {
  id              String   @id @default(uuid(7)) @db.Uuid
  requestId       String   @map("request_id") @db.Uuid
  decision        String
  rejectionReason String?  @map("rejection_reason")
  note            String?
  decidedBy       String   @map("decided_by") @db.Uuid
  decidedAt       DateTime @default(now()) @map("decided_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  request DriverRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  decider User          @relation("DecisionUser", fields: [decidedBy], references: [id])

  @@index([requestId, decidedAt, id])
  @@index([decidedBy])
  @@map("awb_driver_request_decision")
}

model Document {
  id         String   @id @default(uuid(7)) @db.Uuid
  fileKey    String   @unique @map("file_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  category   String   @map("category")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  uploader User @relation("UserDocuments", fields: [uploadedBy], references: [id])

  @@index([uploadedBy, createdAt, id])
  @@map("awb_document")
}

model SapMasterImport {
  id           String    @id @default(uuid(7)) @db.Uuid
  status       String    @default("RUNNING")
  startedById  String    @map("started_by_id") @db.Uuid
  driverCount  Int       @default(0) @map("driver_count")
  vehicleCount Int       @default(0) @map("vehicle_count")
  error        String?
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  @@index([startedAt])
  @@map("sys_sap_master_import")
}

model SyncOutbox {
  id             Int       @id @default(autoincrement())
  eventId        String    @unique @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  siteId         String    @map("site_id")
  aggregateId    String    @map("aggregate_id")
  payload        Json      @map("payload")
  status         String    @default("PENDING") @map("status")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([siteId, id])
  @@index([status, siteId])
  @@map("sys_sync_outbox")
}

model JulDocument {
  id                String    @id @default(uuid(7)) @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  referenceDocument String    @map("reference_document")
  providerMode      String    @map("provider_mode")
  plantId           String    @map("plant_id") @db.Uuid
  snapshot          Json
  fetchedAt         DateTime  @default(now()) @map("fetched_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  customer          User      @relation(fields: [customerId], references: [id])
  plant             Plant     @relation(fields: [plantId], references: [id])
  lines             JulLine[]

  @@unique([customerId, providerMode, referenceDocument])
  @@index([providerMode, referenceDocument, id])
  @@index([plantId, fetchedAt])
  @@map("mst_jul_document")
}

model JulRegistration {
  id           String       @id @default(uuid(7)) @db.Uuid
  number       String       @unique
  customerId   String       @map("customer_id") @db.Uuid
  createdById  String       @map("created_by_id") @db.Uuid
  providerMode String       @map("provider_mode")
  isMulti      Boolean      @default(false) @map("is_multi")
  status       String       @default("DRAFT")
  version      Int          @default(1)
  submittedAt  DateTime?    @map("submitted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  customer     User         @relation("JulCustomer", fields: [customerId], references: [id])
  creator      User         @relation("JulCreator", fields: [createdById], references: [id])
  lines        JulLine[]
  history      JulHistory[]
  jobs         JulJob[]

  @@index([customerId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("awb_jul_registration")
}

model JulLine {
  id                  String          @id @default(uuid(7)) @db.Uuid
  registrationId      String          @map("registration_id") @db.Uuid
  documentId          String          @map("document_id") @db.Uuid
  documentSnapshot    Json            @map("document_snapshot")
  variant             String
  stoNumber           String?         @map("sto_number")
  driverLicenseNumber String?         @map("driver_license_number")
  driverName          String?         @map("driver_name")
  vehiclePlateNumber  String?         @map("vehicle_plate_number")
  quantity            Decimal         @db.Decimal(20, 6)
  loadingDate         DateTime?       @map("loading_date") @db.Date
  mediaTransport      String          @map("media_transport")
  remark              String?
  status              String          @default("DRAFT")
  loadingNoteNumber   String?         @map("loading_note_number")
  sapError            String?         @map("sap_error")
  factoryStorage      String?         @map("factory_storage")
  otherStorage        String?         @map("other_storage")
  factoryValuation    String?         @map("factory_valuation")
  otherValuation      String?         @map("other_valuation")
  factoryBatch        String?         @map("factory_batch")
  otherBatch          String?         @map("other_batch")
  jobId               String?         @map("job_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  registration        JulRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  document            JulDocument     @relation(fields: [documentId], references: [id])
  job                 JulJob?         @relation(fields: [jobId], references: [id])

  @@index([documentId, status])
  @@index([registrationId, createdAt, id])
  @@index([status, loadingDate, id])
  @@index([jobId])
  @@map("awb_jul_line")
}

model JulHistory {
  id             String          @id @default(uuid(7)) @db.Uuid
  registrationId String          @map("registration_id") @db.Uuid
  actorId        String?         @map("actor_id") @db.Uuid
  action         String
  reason         String?
  details        Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  registration   JulRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User?           @relation(fields: [actorId], references: [id])

  @@index([registrationId, createdAt, id])
  @@index([actorId])
  @@map("awb_jul_history")
}

model JulJob {
  id               String          @id @default(uuid(7)) @db.Uuid
  registrationId   String          @map("registration_id") @db.Uuid
  providerMode     String          @map("provider_mode")
  operatorUsername String          @map("operator_username")
  status           String          @default("QUEUED")
  payload          Json
  triggerStartedAt DateTime?       @map("trigger_started_at")
  nextPollAt       DateTime        @default(now()) @map("next_poll_at")
  attempts         Int             @default(0)
  error            String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  registration     JulRegistration @relation(fields: [registrationId], references: [id])
  lines            JulLine[]

  @@index([status, nextPollAt, id])
  @@index([operatorUsername, status])
  @@index([registrationId])
  @@map("sys_jul_job")
}

model JulPlantRule {
  id               String   @id @default(uuid(7)) @db.Uuid
  plantId          String   @map("plant_id") @db.Uuid
  material         String
  incoterm         String
  factoryStorage   String   @map("factory_storage")
  otherStorage     String   @map("other_storage")
  factoryValuation String   @map("factory_valuation")
  otherValuation   String   @map("other_valuation")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  plant            Plant    @relation(fields: [plantId], references: [id])

  @@unique([plantId, material, incoterm])
  @@map("mst_jul_plant_rule")
}

model JulLoadingNoteType {
  id        String   @id @default(uuid(7)) @db.Uuid
  incoterm  String   @unique
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mst_jul_ln_type")
}

model JulTransportMode {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mst_jul_transport_mode")
}

model JulHold {
  id                String   @id @default(uuid(7)) @db.Uuid
  providerMode      String   @map("provider_mode")
  referenceDocument String   @map("reference_document")
  quantity          Decimal  @default(0) @db.Decimal(20, 6)
  actorId           String?  @map("actor_id") @db.Uuid
  reason            String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  actor             User?    @relation(fields: [actorId], references: [id])

  @@unique([providerMode, referenceDocument])
  @@index([actorId])
  @@map("mst_jul_hold")
}

model BelDocument {
  id        String    @id @default(uuid(7)) @db.Uuid
  vendorId  String    @map("vendor_id") @db.Uuid
  poNumber  String    @map("po_number")
  poItem    String    @map("po_item")
  plantId   String    @map("plant_id") @db.Uuid
  snapshot  Json
  fetchedAt DateTime  @default(now()) @map("fetched_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  vendor    User      @relation(fields: [vendorId], references: [id])
  plant     Plant     @relation(fields: [plantId], references: [id])
  lines     BelLine[]

  @@unique([vendorId, poNumber, poItem])
  @@index([poNumber, poItem, id])
  @@index([plantId, fetchedAt])
  @@map("mst_bel_document")
}

model BelRegistration {
  id          String       @id @default(uuid(7)) @db.Uuid
  number      String       @unique
  vendorId    String       @map("vendor_id") @db.Uuid
  createdById String       @map("created_by_id") @db.Uuid
  decidedById String?      @map("decided_by_id") @db.Uuid
  status      String       @default("DRAFT")
  version     Int          @default(1)
  submittedAt DateTime?    @map("submitted_at")
  decidedAt   DateTime?    @map("decided_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  vendor      User         @relation("BelVendor", fields: [vendorId], references: [id])
  creator     User         @relation("BelCreator", fields: [createdById], references: [id])
  decider     User?        @relation("BelDecider", fields: [decidedById], references: [id])
  lines       BelLine[]
  history     BelHistory[]

  @@index([vendorId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("awb_bel_registration")
}

model BelLine {
  id                  String          @id @default(uuid(7)) @db.Uuid
  registrationId      String          @map("registration_id") @db.Uuid
  documentId          String          @map("document_id") @db.Uuid
  documentSnapshot    Json            @map("document_snapshot")
  driverLicenseNumber String?         @map("driver_license_number")
  driverName          String?         @map("driver_name")
  vehiclePlateNumber  String?         @map("vehicle_plate_number")
  quantity            Decimal         @db.Decimal(20, 6)
  loadingDate         DateTime?       @map("loading_date") @db.Date
  mediaTransport      String          @map("media_transport")
  remark              String?
  status              String          @default("DRAFT")
  stagedAt            DateTime?       @map("staged_at")
  stagePayload        Json?           @map("stage_payload")
  stageError          String?         @map("stage_error")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  registration        BelRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  document            BelDocument     @relation(fields: [documentId], references: [id])

  @@index([documentId, status])
  @@index([registrationId, createdAt, id])
  @@index([status, loadingDate, id])
  @@map("awb_bel_line")
}

model BelHistory {
  id             String          @id @default(uuid(7)) @db.Uuid
  registrationId String          @map("registration_id") @db.Uuid
  actorId        String?         @map("actor_id") @db.Uuid
  action         String
  reason         String?
  details        Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  registration   BelRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  actor          User?           @relation(fields: [actorId], references: [id])

  @@index([registrationId, createdAt, id])
  @@index([actorId])
  @@map("awb_bel_history")
}
